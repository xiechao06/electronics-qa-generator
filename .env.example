# DeepSeek API (for text humanization and LLM checks)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# Vision model (for schematic image quality checks via Ollama)
# Install:    brew install ollama       # or download from https://ollama.com
# Start:      ollama serve
# Pull model: ollama pull deepseek-vl2-tiny
VISION_BASE_URL=http://localhost:11434/v1
VISION_MODEL=deepseek-vl2-tiny
